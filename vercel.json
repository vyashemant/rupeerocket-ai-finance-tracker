{
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "rootDirectory": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "rootDirectory": "/backend",
      "framework": "flask"
    }
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
